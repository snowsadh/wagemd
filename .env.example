# WAGE.md environment — copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- OpenAI (agent loops, normalization, and reports) ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna

# --- Tiger Data Cloud / TimescaleDB ---
# For local docker compose: postgresql://wage:wage@localhost:5432/wage_md
TIGER_DATABASE_URL=postgresql://user:password@your-instance.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# --- API / Frontend wiring ---
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
